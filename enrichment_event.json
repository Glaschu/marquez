        "query": "CREATE TABLE enriched_customers AS SELECT customer_id, UPPER(CONCAT(first_name, ' ', last_name)) as full_name_upper, SUBSTRING(email, POSITION('@' IN email) + 1) as email_domain, EXTRACT(YEAR FROM registration_date) as registration_year, CONCAT(city, ', ', state) as full_address FROM customers"
